   "source": [
    "# Uses parameters.CORRIDOR_ZONE_IDS when CORRIDOR_DEFINITION_MODE = \"zones\"\n",
    "zone_ids = tmi.get_zone_ids_for_municipalities(ctx)\n",
    "\n",
    "# Find the municipalities represented by those selected zones\n",
    "selected_zones = ctx.zones.loc[\n",
    "    ctx.zones[\"grid_id\"].astype(str).isin(zone_ids)\n",
    "]\n",
    "municipalities = (\n",
    "    selected_zones[\"municipality_name\"]\n",
    "    .astype(str)\n",
    "    .drop_duplicates()\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "# Restrict the baseline OD matrix to exactly those zones before aggregating\n",
    "zone_od = ctx.baseline_od.copy()\n",
    "zone_od.index = zone_od.index.astype(str)\n",
    "zone_od.columns = zone_od.columns.astype(str)\n",
    "selected_zone_od = zone_od.loc[zone_ids, zone_ids]\n",
    "\n",
    "MUNICIPALITY_OD, MUNICIPALITY_FLOWS = tmi.aggregate_od_by_municipality(\n",
    "    ctx,\n",
    "    municipalities,\n",
    "    matrix=selected_zone_od,\n",
    ")\n",
    "\n",
    "display(MUNICIPALITY_OD)\n",
    "display(MUNICIPALITY_FLOWS.head(20))\n",
    "\n",
    "\n"
   ]
  },
