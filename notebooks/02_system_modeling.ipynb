   "source": [
    "# Resolve the active zone selection from parameters.py\n",
    "zone_ids = tmi.get_zone_ids_for_municipalities(ctx)\n",
    "\n",
    "# Restrict baseline demand to OD pairs whose origin and destination\n",
    "# are both in the selected zones.\n",
    "baseline_od = ctx.baseline_od.copy()\n",
    "baseline_od.index = baseline_od.index.astype(str)\n",
    "baseline_od.columns = baseline_od.columns.astype(str)\n",
    "\n",
    "zone_ids = [\n",
    "    zone_id for zone_id in zone_ids\n",
    "    if zone_id in baseline_od.index and zone_id in baseline_od.columns\n",
    "]\n",
    "selected_od = baseline_od.loc[zone_ids, zone_ids]\n",
    "\n",
    "# The figure groups those selected zones by their municipality names.\n",
    "selected_zones = ctx.zones.loc[\n",
    "    ctx.zones[\"grid_id\"].astype(str).isin(zone_ids)\n",
    "]\n",
    "municipalities = (\n",
    "    selected_zones[\"municipality_name\"].astype(str).drop_duplicates().tolist()\n",
    ")\n",
    "\n",
    "MUNICIPALITY_OD_FIGURE = tmi.municipality_od_explorer(\n",
    "    ctx,\n",
    "    municipalities,\n",
    "    matrix=selected_od,\n",
    ")\n",
    "display(MUNICIPALITY_OD_FIGURE)"
   ]
  },
